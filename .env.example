# Copy to .env in the repo root (it is git-ignored) and fill in. Never commit .env.

# The application database. The app role must NOT be a superuser (startup refuses one).
DATABASE_URL=postgresql+asyncpg://supragents_app:password@localhost:5432/suprpg

# The database the tests may DROP AND REBUILD. The name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/suprpg_test

# DeepSeek key (model deepseek-flash). Used by `python src/main.py` and the live tests.
DEEPSEEK_API_KEY=

# Optional: comma-separated browser origins allowed to call the API (empty = no CORS).
CORS_ORIGINS=
